{
  "productName": "Oh My Pi",
  "version": "0.1.0",
  "identifier": "com.oh-my-pi.app",
  "build": {
    "beforeDevCommand":   "bun run dev",
    "devUrl":             "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "title":         "Oh My Pi",
        "width":          1200,
        "height":         800,
        "minWidth":       800,
        "minHeight":      560,
        "decorations":    true,
        "titleBarStyle":  "Overlay",
        "hiddenTitle":    true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active":    true,
    "targets":   "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher":   "Smruti Ranjan Rana",
    "copyright":   "© 2026 Smruti Ranjan Rana",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey":    "",
      "endpoints": [
        "https://github.com/heyitsranjan/oh-my-pi/releases/latest/download/latest.json"
      ]
    }
  }
}
